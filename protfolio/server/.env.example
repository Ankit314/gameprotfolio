# Server
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Auth
JWT_SECRET=replace-me-with-a-long-random-string

# MongoDB (optional). If unset, the server runs without persistence.
MONGODB_URI=mongodb://localhost:27017/ankit-universe

# Google Gemini (optional). Get a key at https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
